<% set_page_meta title: "#{@gallery.fetch("title")} gallery", description: @gallery.fetch("summary") %>
<% credits_by_media_id = portfolio_catalog.gallery_credits_by_media_id(@gallery) %>

<main id="main-content" class="<%= accent_class(@gallery) %>">
  <header class="page-hero gallery-hero">
    <div class="page-hero__copy">
      <p class="breadcrumb"><%= link_to "Galleries", galleries_path %><% if @section %> <span aria-hidden="true">/</span> <%= @section.fetch("title") %><% end %></p>
      <p class="eyebrow"><%= @gallery.fetch("status") %></p>
      <h1><%= @gallery.fetch("title") %></h1>
      <p class="page-hero__lede"><%= @gallery.fetch("summary") %></p>
      <% if @gallery.fetch("credits").any? %>
        <div class="gallery-credits">
          <% @gallery.fetch("credits").each do |credit| %>
            <%= render "shared/credit", name: credit.fetch("name"), url: credit["url"],
                  label: "#{credit.fetch("media_ids").size} photographs by" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </header>

  <% if @gallery.fetch("media_ids").any? %>
    <section class="media-gallery" aria-label="<%= @gallery.fetch("title") %> media" data-lightbox-gallery>
      <% @gallery.fetch("media_ids").each_with_index do |media_id, index| %>
        <article class="media-gallery__item">
          <button type="button" class="media-gallery__trigger" data-lightbox-index="<%= index %>"
                  aria-label="Expand item <%= index + 1 %> of <%= @gallery.fetch("media_ids").size %>">
            <span class="media-gallery__number"><%= format("%02d", index + 1) %></span>
            <%= portfolio_media_thumbnail media_id, sizes: "(min-width: 76rem) 20rem, 50vw" %>
          </button>
          <% if (credit = credits_by_media_id[media_id]) %>
            <%= render "shared/credit", name: credit.fetch("name"), url: credit["url"],
                  label: "©", class: "credit--tile" %>
          <% end %>
          <template data-lightbox-full>
            <%= portfolio_media media_id, sizes: "90vw" %>
          </template>
        </article>
      <% end %>
    </section>
  <% else %>
    <section class="empty-gallery" aria-labelledby="empty-gallery-title">
      <span class="empty-gallery__pulse" aria-hidden="true"></span>
      <p class="eyebrow">The work exists. The pixels are in transit.</p>
      <h2 id="empty-gallery-title">This gallery is being prepared.</h2>
      <p>The image framework is ready; selected, captioned media will arrive in the next content pass.</p>
      <%= link_to "Browse the other galleries", galleries_path, class: "text-link" %>
    </section>
  <% end %>

  <%= render "shared/contact_cta" %>
</main>
