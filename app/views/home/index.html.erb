<% set_page_meta title: "Light, costume, and metal", description: portfolio_catalog.site.fetch("description") %>

<main id="main-content" class="home-backdrop"
      style="--page-backdrop: url(<%= portfolio_media_backdrop("led/led-gallery/helmets-main-page") %>)">
  <section class="home-hero accent--electric" aria-labelledby="home-title">
    <div class="home-hero__copy">
      <p class="eyebrow">Built in the <%= portfolio_catalog.site.fetch("shop") %></p>
      <h1 id="home-title">Built to <em>glow.</em><br>Forged to <em class="accent--ember">last.</em></h1>
      <p class="home-hero__lede">SPEERD makes responsive light, ambitious costumes, and metalwork that refuses to behave like an accessory.</p>
      <div class="button-row">
        <%= link_to "Explore LED art", led_art_path, class: "button-link" %>
        <%= link_to "Browse every gallery", galleries_path, class: "button-link button-link--quiet" %>
      </div>
    </div>
    <figure class="home-hero__feature">
      <%= portfolio_media "cosplay/disco-chief/armor-main-page",
            sizes: "(min-width: 60rem) 42vw, 100vw", loading: "eager", fetchpriority: "high" %>
      <figcaption class="home-hero__saying">Light as a material</figcaption>
    </figure>
  </section>

  <section class="page-section" aria-labelledby="led-work-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Primary practice</p>
        <h2 id="led-work-title">LED art</h2>
      </div>
      <p>Light built into the object—not added after it.</p>
    </div>
    <div class="project-grid project-grid--featured">
      <% @led_projects.each_with_index do |project, index| %>
        <%= render "shared/project_card", project: project, index: index %>
      <% end %>
    </div>
  </section>

  <%= render "shared/reveal_band", media_id: "led/led-gallery/helmets-main-page" %>

  <section class="discipline-band" aria-labelledby="disciplines-title">
    <div class="section-heading section-heading--light">
      <div>
        <p class="eyebrow">The rest of the workshop</p>
        <h2 id="disciplines-title">Three practices.<br>One Chaos Factory.</h2>
      </div>
    </div>
    <div class="discipline-list">
      <% @sections.each_with_index do |section, index| %>
        <%= link_to section.fetch("path"), class: "discipline-row #{accent_class(section)}" do %>
          <span class="discipline-row__number"><%= format("%02d", index + 1) %></span>
          <span class="discipline-row__title"><%= section.fetch("title") %></span>
          <span class="discipline-row__summary"><%= section.fetch("summary") %></span>
          <span class="discipline-row__arrow" aria-hidden="true">↗</span>
        <% end %>
      <% end %>
    </div>
  </section>

  <section class="manifesto" aria-labelledby="manifesto-title">
    <p class="eyebrow">Working principle</p>
    <h2 id="manifesto-title"><%= portfolio_catalog.site.fetch("manifesto") %></h2>
    <p>Code, steel, foam, wire, patience. The material changes; the practice is learning what the object wants to become.</p>
    <%= link_to "Read the README", about_path, class: "text-link" %>
  </section>

  <%= render "shared/contact_cta" %>
</main>
