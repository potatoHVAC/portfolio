<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="site-footer__mark"><%= portfolio_catalog.site.fetch("name") %> <span aria-hidden="true">—</span> built in the <%= portfolio_catalog.site.fetch("shop") %></p>
    <nav aria-label="Footer navigation">
      <%= link_to "Galleries", galleries_path %>
      <%= link_to "About", about_path %>
      <%= link_to "Contact", contact_path %>
    </nav>
    <p class="site-footer__note">Made by hand. Served by Rails.</p>
    <nav class="site-footer__elsewhere" aria-label="Elsewhere">
      <%= mail_to site_email, "Email" %>
      <% site_socials.each do |network, url| %>
        <%= link_to network, url, rel: "me noopener", target: "_blank" %>
      <% end %>
    </nav>
  </div>
</footer>
