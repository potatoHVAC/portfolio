#!/usr/bin/env bash

set -euo pipefail

: "${DEV_ECR_REPOSITORY:?DEV_ECR_REPOSITORY is required}"
: "${PROD_ECR_REPOSITORY:?PROD_ECR_REPOSITORY is required}"
: "${PROD_FUNCTION_NAME:?PROD_FUNCTION_NAME is required}"
: "${GH_TOKEN:?GH_TOKEN is required}"
: "${GITHUB_REPOSITORY:?GITHUB_REPOSITORY is required}"
: "${GITHUB_SERVER_URL:?GITHUB_SERVER_URL is required}"
: "${GITHUB_OUTPUT:?GITHUB_OUTPUT is required}"
: "${RUNNER_TEMP:?RUNNER_TEMP is required}"

successful_commits="$RUNNER_TEMP/successful-main-commits.txt"
markdown="$RUNNER_TEMP/promotion-candidates.md"

image_age() {
  local pushed=$1
  local pushed_epoch
  local seconds

  [ -n "$pushed" ] || return 0
  if [[ "$pushed" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
    pushed_epoch=${pushed%%.*}
  else
    pushed_epoch=$(date --date="$pushed" +%s 2>/dev/null) || return 0
  fi
  seconds=$(( $(date +%s) - pushed_epoch ))
  (( seconds >= 0 )) || seconds=0
  if (( seconds >= 86400 )); then
    echo "$((seconds / 86400))d"
  elif (( seconds >= 3600 )); then
    echo "$((seconds / 3600))h"
  elif (( seconds >= 60 )); then
    echo "$((seconds / 60))m"
  else
    echo "${seconds}s"
  fi
}

# A git-<sha> image proves the artifact passed the pre-publish gates. A
# successful push run additionally proves the complete dev delivery finished.
gh api --paginate \
  "repos/$GITHUB_REPOSITORY/actions/workflows/ci-cd.yml/runs?branch=main&event=push&status=success&per_page=100" \
  --jq '.workflow_runs[].head_sha' > "$successful_commits"
if [ -n "${INCLUDE_CURRENT_COMMIT:-}" ]; then
  printf '%s\n' "$INCLUDE_CURRENT_COMMIT" >> "$successful_commits"
fi
sort -u "$successful_commits" -o "$successful_commits"

function_exists=true
current_commit=""
current_digest=""
if ! aws lambda get-function \
    --function-name "$PROD_FUNCTION_NAME" \
    --qualifier live \
    --output json > "$RUNNER_TEMP/catalog-function.json" \
    2> "$RUNNER_TEMP/catalog-function-error.txt"; then
  grep -q ResourceNotFoundException "$RUNNER_TEMP/catalog-function-error.txt" || {
    sed -E 's/[0-9]{12}/<ACCOUNT>/g' "$RUNNER_TEMP/catalog-function-error.txt"
    exit 1
  }
  function_exists=false
else
  current_image=$(jq -r '.Code.ResolvedImageUri' "$RUNNER_TEMP/catalog-function.json")
  current_digest=${current_image##*@}
  [[ "$current_digest" =~ ^sha256:[0-9a-f]{64}$ ]] || {
    echo "Production is not digest-pinned; found $current_digest."
    exit 1
  }
  # shellcheck disable=SC2016
  current_tags=$(aws ecr describe-images \
    --repository-name "$PROD_ECR_REPOSITORY" \
    --image-ids "imageDigest=$current_digest" \
    --query 'imageDetails[0].imageTags[?starts_with(@, `git-`)]' \
    --output text 2>/dev/null | tr '\t' ' ' || true)
  while read -r sha; do
    case " $current_tags " in
      *" git-$sha "*) current_commit=$sha; break ;;
    esac
  done < <(git rev-list --first-parent HEAD)
fi

images=$(aws ecr describe-images \
  --repository-name "$DEV_ECR_REPOSITORY" \
  --query imageDetails \
  --output json)
prod_images=$(aws ecr describe-images \
  --repository-name "$PROD_ECR_REPOSITORY" \
  --query imageDetails \
  --output json)
head_sha=$(git rev-parse HEAD)
latest=""
promotable=0
bounded=false
image_count=0
declare -A image_labels=()
{
  echo "## Deploy candidates — Portfolio PROD"
  echo
  echo 'Copy a commit SHA and run this workflow again with action `specific` to deploy it.'
  echo "A commit appears here only after its main CI/CD run completed successfully."
  echo
  echo "| Commit SHA | Message | Image | Age | State |"
  echo "|---|---|---|---|---|"
  while read -r sha; do
    state=""
    if [ -n "$current_commit" ] && [ "$sha" = "$current_commit" ]; then
      digest=$current_digest
      state=PROD
      bounded=true
      detail=$(printf '%s' "$prod_images" | jq -c --arg digest "$digest" \
        'map(select(.imageDigest == $digest)) | .[0] // empty')
    else
      grep -Fxq "$sha" "$successful_commits" || continue
      detail=$(printf '%s' "$images" | jq -c --arg tag "git-$sha" \
        'map(select((.imageTags // []) | index($tag))) | .[0] // empty')
      [ -n "$detail" ] || continue
      digest=$(printf '%s' "$detail" | jq -r .imageDigest)
      if [ -z "$latest" ]; then
        latest=$sha
      fi
      [ "$sha" = "$head_sha" ] && state="DEV head"
      promotable=$((promotable + 1))
    fi
    if [ -z "${image_labels[$digest]+present}" ]; then
      image_count=$((image_count + 1))
      image_labels[$digest]="img $image_count"
    fi
    pushed=$(printf '%s' "$detail" | jq -r '.imagePushedAt // empty')
    age=$(image_age "$pushed")
    subject=$(git log -1 --format=%s "$sha" | tr '|' '/')
    short=$(printf '%.7s' "$sha")
    if [ "$state" = PROD ]; then
      printf -v commit_cell '`%s`' "$short"
    else
      printf -v commit_cell '[`%s`](%s/%s/commit/%s)' \
        "$short" "$GITHUB_SERVER_URL" "$GITHUB_REPOSITORY" "$sha"
    fi
    echo "| $commit_cell | ${subject:0:60} | ${image_labels[$digest]} | $age | $state |"
    [ "$state" = PROD ] && break
  done < <(git rev-list --first-parent HEAD)
  echo
  if [ "$promotable" -eq 0 ]; then
    echo "PROD runs the newest proven build. Nothing to promote."
  else
    if [ "$promotable" -eq 1 ]; then
      count="commit is"
    else
      count="commits are"
    fi
    echo "**$promotable** $count promotable. Rows sharing an image are byte-identical;"
    echo "deploying any of them ships the same bytes under that commit's name."
  fi
  if [ "$function_exists" = true ] && [ "$bounded" != true ]; then
    echo
    echo "The list is not bounded by production: no commit in the first-parent history"
    echo "of main carries what PROD is running, so everything known is shown."
    echo "Promotion still refuses anything that is not ahead of PROD."
  fi
  if [ "$function_exists" != true ]; then
    echo
    echo "The production Lambda does not exist; promotion will only seed production ECR."
  fi
} > "$markdown"

{
  echo "function_exists=$function_exists"
  echo "deployed_commit=$current_commit"
  echo "deployed_digest=$current_digest"
  echo "latest=$latest"
  echo "markdown=$markdown"
} >> "$GITHUB_OUTPUT"
